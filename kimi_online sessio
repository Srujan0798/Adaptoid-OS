from langgraph.graph import StateGraph, END
from typing import TypedDict, Annotated
from mem0 import Memory
from instructor import patch
from openai import OpenAI

# Initialize clients
client = patch(OpenAI(base_url="http://localhost:4000"))
m = Memory()

class AdaptoidState(TypedDict):
    intent: str
    project_context: str
    current_node: str
    proposed_action: str
    output: str
    retries: int

def bootstrap_node(state: AdaptoidState):
    """Forces reading of /vapor/ core files."""
    ctx = read_file("/vapor/core/PROJECT-INTENT.md") + read_file("/vapor/memory/CONTEXT-SNAPSHOT.md")
    return {"project_context": ctx}

def route_sentinel(state: AdaptoidState):
    """Prevents Wrong Routes."""
    allowed = ["code_gen", "research", "plan", "verification", END]
    if state["proposed_action"] not in allowed:
        return "correction_node"
    return state["proposed_action"]

def verification_gate(state: AdaptoidState):
    """Anti-Hallucination Gate."""
    prompt = f"Does the output: {state['output']} strictly satisfy the intent: {state['intent']} based on context: {state['project_context']}? Answer True/False."
    resp = client.chat.completions.create(model="gpt-4o", response_model=bool, messages=[{"role": "user", "content": prompt}])
    if not resp:
        return {"retries": state["retries"] + 1, "proposed_action": "correction_node"}
    # Save to persistent memory
    m.add(state["output"], user="project_1")
    return {"proposed_action": END}

# DAG Construction
graph = StateGraph(AdaptoidState)
graph.add_node("bootstrap", bootstrap_node)
graph.add_node("execution", execution_node)
graph.add_node("verification", verification_gate)

graph.add_edge("bootstrap", "execution")
graph.add_conditional_edges("execution", route_sentinel)
graph.add_edge("verification", END)

app = graph.compile()
