#### In-Agent Runtime Validation (VaultMMU)
```python
# core/vault_mmu.py
import hashlib, json

class VaultMMU:
    """
    Injected into every Adaptoid Agent. Acts as the Memory Management Unit.
    Prevents context drift and hallucination by validating vault state freshness.
    """
    def __init__(self, vault_path="/app/vault"):
        self.vault_path = vault_path

    def _hash_state(self, state_dict: dict) -> str:
        return hashlib.sha256(json.dumps(state_dict, sort_keys=True).encode()).hexdigest()

    def pre_execution_check(self, proposed_action: str):
        """Forces agent to validate context freshness before major state transitions."""
        spec = load_yaml(f"{self.vault_path}/intent/adaptoid_spec.yaml")
        state = load_json(f"{self.vault_path}/workflows/active_dag_state.json")
        
        # 1. Anti-Forgetting: Validate we are in the correct DAG node
        if proposed_action not in spec['allowed_transitions'][state['current_node']]:
            log_error("Wrong Route", state['current_node'], proposed_action)
            self.refresh_context() # Force re-read
            return False
            
        # 2. Anti-Staleness: Cryptographic check of context integrity
        current_hash = self._hash_state(state)
        if current_hash != state['last_known_hash']:
            log_error("Context Drift Detected", current_hash, state['last_known_hash'])
            self.refresh_context()
            return False
            
        return True

    def commit_state(self, new_state: dict):
        """Commits new state with updated hash, creating an immutable audit trail."""
        new_state['last_known_hash'] = self._hash_state(new_state)
        save_json(f"{self.vault_path}/workflows/active_dag_state.json", new_state)
```

