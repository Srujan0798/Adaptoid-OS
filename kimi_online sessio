from typing import List, Literal, Dict
import yaml

class VerificationGate(BaseModel):
    gate_type: Literal["human_approval", "red_team_adversarial", "evidence_grounding", "schema_validation", "cryptographic_hash"]
    config: Dict = {}

class AdaptoidSpec(BaseModel):
    project_name: str
    risk_level: Literal["low", "medium", "critical"]
    orchestration_runtime: Literal["langgraph", "autogen", "crewai", "deerflow_dag"]
    parallelism_profile: Literal["sequential", "fan_out_fan_in", "conductor"]
    memory_architecture: Literal["markdown_only", "graph_vector_hybrid", "episodic_paging"]
    verification_gates: List[VerificationGate]
    skill_packs: List[str]
    cost_routing: Literal["priority_quality", "balanced", "priority_cost"]

def compile_intent(intent_description: str, constraints: dict) -> AdaptoidSpec:
    """
    Compiles unstructured intent into a deterministic AdaptoidSpec.
    """
    spec = client.chat.completions.create(
        model="o1-preview",
        response_model=AdaptoidSpec,
        messages=[{
            "role": "system", 
            "content": open('/adapter/prompts/compiler_system.md').read()
        }, {
            "role": "user",
            "content": f"Intent: {intent_description}\nConstraints: {constraints}"
        }]
    )
    # Save as executable artifact
    with open('vault/intent/adaptoid_spec.yaml', 'w') as f:
        yaml.dump(spec.model_dump(), f)
    return spec
